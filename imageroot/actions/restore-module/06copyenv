import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
    ]:
    agent.set_env(evar, original_environment[evar])

# Secrets stored by Dolibarr are encrypted with this key
if original_environment.get("DOLI_INSTANCE_UNIQUE_ID"):
    agent.set_env("DOLI_INSTANCE_UNIQUE_ID", original_environment["DOLI_INSTANCE_UNIQUE_ID"])

agent.dump_env()
