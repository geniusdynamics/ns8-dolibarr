import json
import os
import secrets
import sys
import agent

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

# Setup Values
DOLI_ADMIN_LOGIN = data.get("DOLI_ADMIN_LOGIN", "admin")
DOLI_ADMIN_PASSWORD = data.get("DOLI_ADMIN_PASSWORD", "admin")

agent.set_env("DOLI_ADMIN_LOGIN", DOLI_ADMIN_LOGIN)
agent.set_env("DOLI_ADMIN_PASSWORD", DOLI_ADMIN_PASSWORD)

# Key of dolEncrypt(); the image falls back to the public value
# "myinstanceuniquekey" without it. Generated once, never changed.
if not os.environ.get("DOLI_INSTANCE_UNIQUE_ID"):
    agent.set_env("DOLI_INSTANCE_UNIQUE_ID", secrets.token_hex(32))

agent.dump_env()
