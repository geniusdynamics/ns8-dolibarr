#
# Move secrets that older releases stored with agent.set_env() (in the
# module environment, copied to Redis and readable by every module of the
# node) to state/passwords.env, mode 0600, and remove them from the
# environment. It runs on every update and does nothing once moved.
#

import os
import agent

SECRETS = ['DOLI_ADMIN_PASSWORD']

path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
try:
    current = agent.read_envfile(path)
except FileNotFoundError:
    current = {}

moved = {key: os.environ[key] for key in SECRETS if key in os.environ and key not in current}
if moved or not os.path.exists(path):
    current.update(moved)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        for key in sorted(current):
            fp.write(f"{key}={current[key]}\n")
os.chmod(path, 0o600)

for key in SECRETS:
    agent.unset_env(key)

# The LDAP bind password comes from discovery_ldap.env: drop the old copy
agent.unset_env("DOLI_LDAP_BIND_PASS")
